#! /bin/sh
# fixscript will replace this line with code to load innshellvars

########################################################################
# controlbatch - Run controlchan against a batch file.
#
# Command usage: controlbatch [feedsite batchfile]
# Defaults are feedsite: controlchan!, batchfile: ${BATCH}/controlchan!
########################################################################
#
# This script will run controlchan against a batch file.  You can use
# it to clear occasional backlogs while running controls from a
# channel, or even skip the channel and run control messages as a file
# feed.
#
########################################################################
#
# If you're doing the channel thing, you might want to put something
# like this in your crontab to do a cleanup in the wee hours:
#
#       00 04 * * *     <pathbin>/controlbatch
#
########################################################################
#
# If you would rather skip the channel and just process controls each
# hour in a batch, use this newsfeeds entry instead of the "stock"
# version:
#
# controlchan!\
#       :!*,control,control.*,!control.cancel\
#       :Tf,Wnsm:
#
# And, a crontab entry something like this:
#
#       30 * * * *     <pathbin>/controlbatch
#
########################################################################

batchlock="${LOCKS}/LOCK.controlbatch"
mypid=$$

# Number of consecutive failed runs of controlchan on the same batch after
# which the batch is set aside (renamed to batchfile.failed.<date>) so that
# the following control articles can still be processed.
maxtries=3

# A concession to INN 1.x
if [ me${PATHBIN}ow = meow ]; then
    PATHBIN=${NEWSBIN}
    export PATHBIN
fi

# See if we have no arguments and should use the defaults. If there are
# arguments, make sure we have enough to attempt something useful.
if [ me${1}ow != meow ]; then
    if [ me${2}ow = meow ]; then
        echo "Usage: ${0} [feedsite batchfile]" >&2
        exit 1
    else
        feedsite=${1}
        batchfile=${2}
    fi
else
    feedsite=controlchan\!
    batchfile=controlchan\!
fi

# Check if any other copies of controlbatch are running.  If we are not
# alone, give up here and now.
"${PATHBIN}/shlock" -p "$mypid" -f "${batchlock}" || exit 0

cd "${BATCH}" || {
    echo "${0}: cannot cd to ${BATCH}" >&2
    rm -f "${batchlock}"
    exit 1
}

# Add the batch file set aside as batchfile.work to the file of the control
# articles to process, batchfile.doit.  The first one is only removed once
# the second one has been completely written, so that no control article is
# lost when, for instance, the disk is full.  The new content of the second
# file is first written to a temporary file in order not to leave a partial
# copy of batchfile.work in it, which would be added again on the next run.
addwork() {
    rm -f "${batchfile}.new"
    if [ -s "${batchfile}.doit" ]; then
        cat "${batchfile}.doit" "${batchfile}.work" >"${batchfile}.new"
    else
        cat "${batchfile}.work" >"${batchfile}.new"
    fi \
        && mv -f "${batchfile}.new" "${batchfile}.doit" \
        && rm -f "${batchfile}.work" \
        && return 0
    rm -f "${batchfile}.new"
    echo "${0}: cannot add ${BATCH}/${batchfile}.work to" \
        "${BATCH}/${batchfile}.doit" >&2
    return 1
}

# A batch file left as batchfile.work was set aside by a previous run which
# could not flush the file feed:  innd may still append control articles to
# it.  It is only taken into account when innd has switched to a new file,
# which is the case when the flush is successful now.  Otherwise, it is left
# in place, as well as the batch file, for the next run.
work=true
if [ -s "${batchfile}.work" ]; then
    work=false
    if "${PATHBIN}/ctlinnd" -s -t30 flush "${feedsite}"; then
        addwork && work=true
    fi
fi

if ${work} && [ -s "${batchfile}" ]; then
    mv "${batchfile}" "${batchfile}.work"
    if "${PATHBIN}/ctlinnd" -s -t30 flush "${feedsite}"; then
        addwork
    fi
fi

if [ -s "${batchfile}.doit" ]; then
    # Only remove the batch file on success.  If controlchan exits with
    # a non-zero status (for instance because it died while processing
    # one of the control articles), leave it in place so that it is
    # retried on the next run instead of silently losing the control
    # articles it did not get to process.
    if "${PATHBIN}/controlchan" \
        <"${batchfile}.doit" >>"${MOST_LOGS}/controlbatch.log" 2>&1; then
        rm -f "${batchfile}.doit" "${batchfile}.tries"
    else
        # Count the consecutive failures.  After maxtries of them, set the
        # batch file aside so that a control article on which controlchan
        # always fails does not prevent the next ones from being processed.
        tries=0
        if [ -s "${batchfile}.tries" ]; then
            tries=$(cat "${batchfile}.tries")
        fi
        case "${tries}" in
        '' | *[!0-9]*) tries=0 ;;
        esac
        tries=$((tries + 1))
        if [ "${tries}" -ge "${maxtries}" ]; then
            failed="${batchfile}.failed.$(date +%Y%m%d%H%M%S)"
            mv "${batchfile}.doit" "${failed}"
            rm -f "${batchfile}.tries"
            message="${0}: controlchan failed ${tries} times in a row on"
            message="${message} ${BATCH}/${batchfile}.doit, which has been"
            message="${message} moved to ${BATCH}/${failed}"
            echo "${message}" >>"${MOST_LOGS}/controlbatch.log"
            echo "${message}" >&2
        else
            echo "${tries}" >"${batchfile}.tries"
        fi
    fi
fi

rm -f "${batchlock}"
