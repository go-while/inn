#! /usr/bin/perl
# fixscript will replace this line with code to load INN::Config

# Author:       James Brister <brister@vix.com> -- berkeley-unix --
# Start Date:   Fri, 25 Apr 1997 14:11:23 +0200
# Project:      INN
# File:         innmail
# Description:  A simple replacement for UCB Mail to avoid nasty security
#               problems.
#
# Various bug fixes, code and documentation improvements since then
# in 1998, 1999, 2007, 2009, 2011, 2021-2024.

use strict;
use warnings;

use bytes ();
use Getopt::Std;

# Define variables Getopt::Std uses for --help and --version.
$Getopt::Std::STANDARD_HELP_VERSION = 1;
our $VERSION = $INN::Config::version;
$VERSION =~ s/INN //;

$0 =~ s!.*/!!;

die "$0: No mta parameter defined in inn.conf.\n"
  if !defined($INN::Config::mta);

my $sm = $INN::Config::mta;

die "$0: MTA path is not absolute in inn.conf\n" unless ($sm =~ m!^/!);

my $usage = "Usage:
  $0 [-h] [-a header] [-s subject] addresses

Options:
  -a header    Adds the specified header field
               (for instance 'Auto-Submitted: auto-generated')
  -h           Prints this help message
  -s subject   Sets the Subject header field body of the mail

  addresses is a space-separated list of mail addresses.

  Reads stdin for message body.
  MTA used: $sm
";

sub HELP_MESSAGE {
    print $usage;
    exit(0);
}

my (%opt, @addrs);
getopts("a:hs:", \%opt) || die $usage;

HELP_MESSAGE() if defined($opt{'h'});

if (!defined($opt{'s'})) {
    warn "No subject given.  Hope that's OK.\n";
    $opt{'s'} = "NO SUBJECT";
} else {
    $opt{'s'} =~ s/\n+\Z//;
}

# Check the addresses.  They are given as arguments to the MTA (without
# using a shell) and written in the To header field, so only the characters
# of an unquoted local part (atext in RFC 5322), "." and "@", and well-formed
# UTF-8 non-ASCII characters other than whitespace and controls are accepted.
# An address is never rewritten: one with other characters (whitespace,
# quotes, angle brackets, control characters...) or malformed UTF-8 is
# refused with a warning, and so is one beginning with "-", "|" or "/",
# which the MTA could take as an option, a program or a file (these
# characters are only refused at the beginning).  The mail is still sent to
# the other addresses, but innmail then exits with status 1.
my $addrchar = qr{[a-zA-Z0-9!#\$%&'*+/=?^_`\{|\}~.\@-]};

# Match RFC 3629 byte sequences, excluding C1 controls and non-ASCII
# characters with the Unicode White_Space property.
my $utf8char = qr{
    (?! \xC2[\x80-\xA0] | \xE1\x9A\x80 | \xE2\x80[\x80-\x8A\xA8\xA9\xAF]
      | \xE2\x81\x9F | \xE3\x80\x80 )
    (?:
        [\xC2-\xDF][\x80-\xBF]
      | \xE0[\xA0-\xBF][\x80-\xBF]
      | [\xE1-\xEC\xEE-\xEF][\x80-\xBF]{2}
      | \xED[\x80-\x9F][\x80-\xBF]
      | \xF0[\x90-\xBF][\x80-\xBF]{2}
      | [\xF1-\xF3][\x80-\xBF]{3}
      | \xF4[\x80-\x8F][\x80-\xBF]{2}
    )
}x;

my %leading = ('-' => 'an option', '|' => 'a program', '/' => 'a file');
my $refused = 0;
foreach my $arg (@ARGV) {
    # Work with the original octets, even if Perl marked @ARGV as UTF-8.
    my $addr = bytes::substr($arg, 0);
    next if ($addr eq "");
    if ($addr =~ m{^([-|/])}) {
        warn "$0: Refusing address beginning with '$1'"
          . " (the MTA could take it as $leading{$1}): $addr\n";
        $refused = 1;
    } elsif ($addr !~ /\A(?:$addrchar|$utf8char)+\z/) {
        warn "$0: Refusing address with unsupported characters: $addr\n";
        $refused = 1;
    } else {
        push(@addrs, $addr);
    }
}

die "$0: No valid addresses specified\n\n$usage" unless @addrs;

if ($sm =~ m!%s!) {
    $sm = sprintf $sm, join(' ', @addrs);
} else {
    $sm .= " " . join(' ', @addrs);
}

my @smarr = split(/\s+/, $sm);

(my $t = $INN::Config::mta) =~ s!\s.*!!;
die "$0: MTA variable definition is changed after substitution\n"
  if ($t ne $smarr[0]);

die "$0: MTA executable doesn't appear to exist: $smarr[0]\n"
  if !-x $smarr[0];

# Startup MTA without using the shell.
my $pid = open my $MTA, '|-';
if ($pid == 0) {
    exec(@smarr) || die "$0: exec of $sm failed: $!\n";
} elsif ($pid < 0) {
    die "$0: Fork failed: $!\n";
}

print $MTA "To: ", join(",\n\t", @addrs), "\n";
print $MTA "Subject: $opt{'s'}\n";
print $MTA "$opt{'a'}\n" if defined($opt{'a'});
print $MTA "\n";
while (<STDIN>) {
    print $MTA $_;
}
close $MTA;
exit($refused ? 1 : 0);
