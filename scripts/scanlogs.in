#! /bin/sh
# fixscript will replace this line with code to load innshellvars

##  Summarize INN log files and rotate them.
##  Used by news.daily.
##
##  Optional arguments:
##      norotate      Do not rotate logfiles.

##  Directory where old log files are kept.
OLD=${MOST_LOGS}/OLD

##  Files defined in innshellvars.  We repeat them for clarity.
ERRLOG=${MOST_LOGS}/errlog
LOG=${MOST_LOGS}/news

##  If you want to archive the active file, enable this line.
ACTIVEFILE=${ACTIVE}

##  Maximum number of lines to show from error log files.
MAXERRLINES=50

##  Where these programs, if used, write their logs.
##  We also have to find innfeed's log file.
CONTROLBATCH=${MOST_LOGS}/controlbatch.log
INNFEEDCONF="${PATHETC}/innfeed.conf ${PATHETC}/innfeed-delayed.conf"
INNFEED=
if [ -f "${MOST_LOGS}/innfeed.log" ]; then
    INNFEED="${MOST_LOGS}/innfeed.log"
fi
INNFEEDPIDFILES=
if [ -f "${PATHRUN}/innfeed.pid" ]; then
    INNFEEDPIDFILES="${PATHRUN}/innfeed.pid"
fi
for F in ${INNFEEDCONF}; do
    if [ -f "${F}" ]; then
        INNFEEDLOG=$(${AWK} '{gsub(/:|#/, " & ")} \
                             {if ($1 == "log-file" && $2 == ":" \
                                  && $3 != "innfeed.log") \
                                  print $3}' ${F})
        INNFEEDPID=$(${AWK} '{gsub(/:|#/, " & ")} \
                             {if ($1 == "pid-file" && $2 == ":" \
                                  && $3 != "innfeed.pid") \
                                  print $3}' ${F})
    fi
    for L in ${INNFEEDLOG}; do
        if [ -f "${MOST_LOGS}/${L}" ]; then
            INNFEED="${INNFEED} ${MOST_LOGS}/${L}"
        fi
    done
    for P in ${INNFEEDPID}; do
        if [ -f "${PATHRUN}/${P}" ]; then
            INNFEEDPIDFILES="${INNFEEDPIDFILES} ${PATHRUN}/${P}"
        fi
    done
done
NNTPSEND=${MOST_LOGS}/nntpsend.log
PERLNOCEM=${MOST_LOGS}/perl-nocem.log
SENDIHAVE=${MOST_LOGS}/send-ihave.log
SENDUUCP=${MOST_LOGS}/send-uucp.log
LIVEFILES="${CONTROLBATCH} ${INNFEED} ${NNTPSEND} ${PERLNOCEM} \
    ${SENDIHAVE} ${SENDUUCP}"

##  Where news.daily places expire output, unless noexplog was used.
EXPLOG=${MOST_LOGS}/expire.log

##  If you divide your news syslog into separate files, list them here.
SYSLOG_CRIT=${MOST_LOGS}/news.crit
SYSLOG_ERR=${MOST_LOGS}/news.err
SYSLOG_NOTICE=${MOST_LOGS}/news.notice
SYSLOGS="${SYSLOG_CRIT} ${SYSLOG_ERR} ${SYSLOG_NOTICE}"

##  Where tally control processor is found.
TALLY_CONTROL=${PATHBIN}/tally.control
UNWANTED_LOG=${MOST_LOGS}/unwanted.log
CONTROL_LOG=${MOST_LOGS}/control.log
CONTROL_DATA=
test -f ${MOST_LOGS}/newgroup.log && CONTROL_DATA=${MOST_LOGS}/newgroup.log
test -f ${MOST_LOGS}/rmgroup.log \
    && CONTROL_DATA="${CONTROL_DATA} ${MOST_LOGS}/rmgroup.log"

##  Build up the list of log files to process.
LOGS="${ERRLOG} ${LOG} ${ACTIVEFILE} ${EXPLOG} ${SYSLOGS} ${UNWANTED_LOG}"

for F in ${LIVEFILES}; do
    test -n "${F}" -a -f "${F}" && LOGS="${LOGS} ${F}"
done

test -n "${CONTROL_DATA}" && LOGS="${LOGS} ${CONTROL_LOG}"

for F in checkgroups default ihave newgroup rmgroup sendme sendsys \
    senduuname version miscctl badcontrol failedpgp badpgp; do
    test -f ${MOST_LOGS}/${F}.log && LOGS="${LOGS} ${MOST_LOGS}/${F}.log"
done

PROGNAME=scanlogs
LOCK=${LOCKS}/LOCK.${PROGNAME}

##  Set defaults.
ROTATE=true

##  Parse JCL.
for I; do
    case "X${I}" in
    Xnorotate)
        ROTATE=false
        ;;
    *)
        echo "Unknown flag ${I}" 1>&2
        exit 1
        ;;
    esac
done

result=0
##  Keep the compressor and its arguments in "$@" during rotation.  Runtime
##  arguments are whitespace-separated words, with no shell or glob expansion.
if ${ROTATE}; then
    COMPRESS_EXT=${Z}
    set -f
    if [ -n "${COMPRESSFORMAT}" ]; then
        set -- ${COMPRESSFORMAT}
        case "${1##*/}" in
        gzip)     COMPRESS_EXT=.gz ;;
        bzip2)    COMPRESS_EXT=.bz2 ;;
        compress) COMPRESS_EXT=.Z ;;
        xz)       COMPRESS_EXT=.xz ;;
        cat)      COMPRESS_EXT='' ;;
        *)
            echo "$0: unknown compressformat: ${COMPRESSFORMAT}" >&2
            set --
            result=1
            ;;
        esac
        if [ "$#" -gt 0 ] && ! command -v "$1" >/dev/null 2>&1; then
            echo "$0: log compressor unavailable: $1" >&2
            set --
            result=1
        fi
    else
        set -- ${LOG_COMPRESS}
    fi
    set +f
fi

archive_tmp=
cleanup_rotation() {
    status=$?
    ##  A further signal must not cut the cleanup short.
    trap '' 1 2 3 15
    ##  Resume the server unless resumeserver already failed and reported it.
    if [ "${RESUMESTATUS}" -eq 0 ]; then
        resumeserver || status=1
    fi
    if [ -n "${archive_tmp}" ]; then
        rm -f "${archive_tmp}"
        rmdir "${archive_tmp%/*}"
    fi
    ##  Only remove the lock of this run:  it may be held by another one.
    LOCKPID=
    { read LOCKPID <"${LOCK}"; } 2>/dev/null
    test "${LOCKPID}" = "$$" && rm -f "${LOCK}"
    exit "${status}"
}

##  Make sure every log exists.
for F in ${LOGS}; do
    test ! -f ${F} && touch ${F}
done

##  Exit status: 1 when the server could not be resumed.
RESUMESTATUS=0

##  Rotate the logs?
if ${ROTATE}; then
    ##  Resume the server if this run paused it.  It is called when the
    ##  rotation is done, and also on errors and when a signal is received,
    ##  so that the server is not left paused by scanlogs.  PAUSED is "maybe"
    ##  from the moment the pause is requested (a signal can arrive before
    ##  innd's reply), "true" once it is acknowledged, and "false" again only
    ##  when the server is known not to be paused by this run any more.  The
    ##  reason is specific to this run:  its "go" cannot release a pause made
    ##  by someone else.
    PAUSED=false
    PAUSEREASON="Flushing log and syslog files $$"
    resumeserver() {
        test "${PAUSED}" = false && return 0
        GOOUTPUT=$(ctlinnd -s go "${PAUSEREASON}" 2>&1) && {
            PAUSED=false
            return 0
        }
        ##  The reply to go, or to the pause, may have been lost:  look at
        ##  what the server does.  A failed query proves nothing.
        if SERVERMODE=$(ctlinnd mode 2>&1); then
            SERVERMODE=$(echo "${SERVERMODE}" | ${SED} 1q)
            if [ "${SERVERMODE}" != "Server paused ${PAUSEREASON}" ]; then
                ##  Running (go did work, or the pause was refused), or
                ##  paused by someone else.
                PAUSED=false
                return 0
            fi
        fi
        echo "${GOOUTPUT}" 1>&2
        echo "$0: cannot resume innd, run: ctlinnd go \"${PAUSEREASON}\"" 1>&2
        return 1
    }
    ##  On every exit after this point, cleanup_rotation resumes the server,
    ##  removes a partly written archive and releases the lock of this run.
    ##  The traps are set before the lock is taken, so that a signal right
    ##  after shlock cannot leave the lock behind.  A signal only reports the
    ##  interruption and makes the exit status 1.
    trap cleanup_rotation 0
    trap 'echo "$0: log rotation interrupted" >&2; exit 1' 1 2 3 15

    ##  Lock out others.
    shlock -p $$ -f ${LOCK} || {
        echo "$0: Locked by $(cat ${LOCK})"
        exit 1
    }

    HERE=$(pwd)
    cd "${MOST_LOGS}" || exit 1
    mkdir -p "${OLD}" || exit 1

    ##  Save what an interrupted run left behind before flushing:  a log not
    ##  yet archived (OLD/<log>), an archive not yet aged (OLD/<log>.0 with
    ##  or without a suffix) and a flushed log not yet moved to OLD (<log>.old
    ##  in pathlog).  The steps below would remove or overwrite them.  Keep
    ##  them outside the numbered generations so they are not aged out.
    recovered_dir=
    save_pending() {
        test -f "$1" || return 0
        if [ -z "${recovered_dir}" ]; then
            recovered_dir="${OLD}/recovered.$$"
            n=0
            while [ -e "${recovered_dir}" ] || [ -L "${recovered_dir}" ]; do
                n=$((n + 1))
                recovered_dir="${OLD}/recovered.$$.${n}"
            done
            (umask 077 && mkdir "${recovered_dir}") || exit 1
        fi
        mv "$1" "${recovered_dir}/$2" || exit 1
        echo "$0: saved pending log to ${recovered_dir}/$2" >&2
    }
    for F in ${LOGS}; do
        BASE=${F##*/}
        save_pending "${OLD}/${BASE}" "${BASE}"
        for suffix in '' .gz .bz2 .Z .xz "${Z}"; do
            save_pending "${OLD}/${BASE}.0${suffix}" "${BASE}.0${suffix}"
        done
        ##  The active file is copied, not flushed, and unwanted.log is
        ##  copied without being reset:  neither has a pending .old file.
        case ${F} in
        ${ACTIVEFILE} | ${UNWANTED_LOG}) ;;
        *)
            save_pending "${F}.old" "${BASE}.old"
            ;;
        esac
    done

    ctlinnd -s logmode
    PAUSED=maybe
    if ctlinnd -s pause "${PAUSEREASON}" 2>&1; then
        PAUSED=true
    fi

    ##  First, flush log files to be sure everything has been recorded
    ##  before rotating them.
    OUTPUT=$(ctlinnd flushlogs 2>&1)
    if [ "$OUTPUT" != "Ok" -a "$OUTPUT" != "In debug mode" ]; then
        echo "$OUTPUT"
        echo 'Cannot flush logs.'
        exit 1
    fi

    ##  Make sure these .old files exist, in case innd is down.
    for F in ${LOG} ${ERRLOG}; do
        if [ ! -f ${F}.old ]; then
            rm -f ${F}.old
            cp ${F} ${F}.old
            cat /dev/null >${F}
        fi
    done

    ##  Copy syslog files, truncating old inode since syslog has it open.
    for F in ${SYSLOGS}; do
        rm -f ${F}.old
        cp ${F} ${F}.old
        cat /dev/null >${F}
    done
    ctlinnd -s logmode

    ##  Make a copy of the active file.
    if [ -n ${ACTIVEFILE} ]; then
        BASE=$(basename ${ACTIVEFILE})
        rm -f ${OLD}/${BASE}.old
        cp ${ACTIVEFILE} ${OLD}/${BASE}.old
    fi

    ##  These are live files, so use link rather than copy.
    for F in ${LIVEFILES}; do
        if [ -f ${F} ]; then
            rm -f ${F}.old ${F}.new
            ln ${F} ${F}.old
            touch ${F}.new
            chmod 0660 ${F}.new
            mv ${F}.new ${F}
        fi
    done

    ##  Tally control messages if we logged them.
    test -n "${CONTROL_DATA}" && cat ${CONTROL_DATA} | ${TALLY_CONTROL}

    ##  Find out the PID of innfeed now and not at the beginning of scanlogs
    ##  because it is restarted when running ctlinnd flushlogs.
    for F in ${INNFEEDPIDFILES}; do
        INNFEEDPID=
        test -f "${F}" && INNFEEDPID=$(cat "${F}")
        ##  Send a HUP signal to innfeed so that it reopens its log files.
        if [ ! -z ${INNFEEDPID} ]; then
            kill -HUP ${INNFEEDPID} >/dev/null 2>&1
        fi
    done

    resumeserver || RESUMESTATUS=1

    cd ${OLD}
    for F in ${LOGS}; do
        ##  Process the current (just-flushed) log.
        BASE=$(basename ${F})
        case ${F} in
        ${SYSLOG_CRIT} | ${SYSLOG_ERR} | ${ERRLOG} | ${LOG} | \
            ${SYSLOG_NOTICE} | ${PERLNOCEM})
            ##  Make a link that can be deleted (since if not rotating
            ##  we delete the copy that is made in ${TMPDIR}).
            if [ -f ${F}.old ]; then
                mv ${F}.old ${OLD}/${BASE}
                rm -f ${OLD}/${BASE}.0
                ln ${OLD}/${BASE} ${OLD}/${BASE}.0
            fi
            ;;
        ${ACTIVEFILE})
            mv ${BASE}.old ${OLD}/${BASE}
            ;;
        ${UNWANTED_LOG})
            ##  innreport assumes where unwanted.log exists, so leave it.
            ##  This log file is not reset because it keeps the count of
            ##  articles posted to newsgroups not present in the active file.
            ##  Just copy the current file without removing it.
            if [ -f ${F} ]; then
                cp ${F} ${OLD}/${BASE}
                chmod 0440 ${OLD}/${BASE}
            fi
            ;;
        *)
            if [ -f ${F}.old ]; then
                mv ${F}.old ${OLD}/${BASE}
            else
                rm -f ${F}.new
                touch ${F}.new
                chmod 0660 ${F}.new
                ln ${F} ${F}.old
                mv ${F}.new ${F}
                mv ${F}.old ${OLD}/${BASE}
            fi
            ;;
        esac
    done
    cd ${HERE}

else
    ##  Don't use the real OLD directory, instead use TMPDIR.
    OLD=${TMPDIR}

    ##  Make a snapshot of what we need for below.
    ctlinnd -s pause "Snapshot log and syslog files" 2>&1
    for F in ${SYSLOG_CRIT} ${SYSLOG_ERR} ${ERRLOG} ${LOG} ${SYSLOG_NOTICE} \
        ${PERLNOCEM}; do
        BASE=$(basename ${F})
        rm -f ${OLD}/${BASE}.0
        test -f ${F} && cp ${F} ${OLD}/${BASE}.0
    done
    ctlinnd -s go "Snapshot log and syslog files" 2>&1
fi

##
##  We now (finally!) have copies of the log files where we need them.
##

##  Display syslog critical messages.
BASE=$(basename ${SYSLOG_CRIT})
OLD_SYSLOG=${OLD}/${BASE}.0
if [ -s ${OLD_SYSLOG} ]; then
    echo Syslog critical messages:
    cat ${OLD_SYSLOG} | head -n ${MAXERRLINES}
    echo ''
    echo ---------
    echo ''
fi
rm -f ${OLD_SYSLOG}

##  Display syslog error messages.
BASE=$(basename ${SYSLOG_ERR})
OLD_SYSLOG=${OLD}/${BASE}.0
if [ -s ${OLD_SYSLOG} ]; then
    echo Syslog error messages:
    cat ${OLD_SYSLOG} | head -n ${MAXERRLINES}
    echo ''
    echo ---------
    echo ''
fi
rm -f ${OLD_SYSLOG}

##  Display error log.
BASE=$(basename ${ERRLOG})
OLD_ERRLOG=${OLD}/${BASE}.0
if [ -s ${OLD_ERRLOG} ]; then
    echo Error log:
    cat ${OLD_ERRLOG} | head -n ${MAXERRLINES}
    echo ''
    echo ---------
    echo ''
fi
rm -f ${OLD_ERRLOG}

##  Scan for various problems in articles we were offered or sent...
BASE=$(basename ${LOG})
OLD_LOG=${OLD}/${BASE}.0

##  and summarize syslog information.
BASE=$(basename ${SYSLOG_NOTICE})
OLD_SYSLOG=${OLD}/${BASE}.0

##  Also add possible logs from perl-nocem.log to the analysis.
BASE=$(basename ${PERLNOCEM})
OLD_PERLNOCEM=${OLD}/${BASE}.0
if [ ! -f ${OLD_PERLNOCEM} ]; then
    OLD_PERLNOCEM=
fi

INNREPORT=${TMPDIR}/innreport$$
if [ -s ${OLD_SYSLOG} -o -s ${OLD_LOG} ]; then
    ${PATHBIN}/innreport -f ${PATHETC}/innreport.conf \
        ${OLD_LOG} ${OLD_SYSLOG} ${OLD_PERLNOCEM} >${INNREPORT}
    if [ -s ${INNREPORT} ]; then
        cat ${INNREPORT}
        echo ''
        echo ---------
        echo ''
    fi
fi
rm -f ${OLD_LOG} ${OLD_SYSLOG} ${OLD_PERLNOCEM} ${INNREPORT}

##  Compress and rotate the logs while preserving the source on failure.
rotate_archives() {
    cd "${OLD}" || return 1
    if [ X${LOGCYCLES} = X ]; then
        LOGCYCLES=3
    fi
    if [ "$#" -gt 0 ]; then
        ##  Stage output on the archive filesystem for an atomic rename.
        stage="${OLD}/.scanlogs.$$"
        (umask 077 && mkdir "${stage}") || return 1
        archive_tmp="${stage}/archive"
    fi
    for F in ${LOGS}; do
        ##  Skip if file doesn't exist.
        BASE=$(basename ${F})
        test -f ${BASE} || continue

        ##  On compressor failure keep this generation in plain text.
        EXT=${COMPRESS_EXT}
        if [ "$#" -gt 0 ] && "$@" <"${BASE}" >"${archive_tmp}"; then
            chmod 0440 "${archive_tmp}" || return 1
            mv -f "${archive_tmp}" "${BASE}.0${EXT}" || return 1
            rm -f "${BASE}"
        else
            if [ "$#" -gt 0 ]; then
                echo "$0: compression failed for ${BASE}, keeping plain log" >&2
                rm -f "${archive_tmp}"
            fi
            mv -f "${BASE}" "${BASE}.0" || return 1
            chmod 0440 "${BASE}.0"
            result=1
        fi

        ##  Older generations retain their original compression method.
        for suffix in '' .gz .bz2 .Z .xz "${Z}"; do
            age=${LOGCYCLES}
            rm -f "${BASE}.${age}${suffix}"
        done
        age=${LOGCYCLES}
        while [ "${age}" -gt 0 ]; do
            next=${age}
            age=$(expr "${age}" - 1)
            for suffix in '' .gz .bz2 .Z .xz "${Z}"; do
                if [ -f "${BASE}.${age}${suffix}" ]; then
                    mv -f "${BASE}.${age}${suffix}" "${BASE}.${next}${suffix}" || return 1
                fi
            done
        done
    done
    return "${result}"
}

if ${ROTATE}; then
    rotate_archives "$@"
    result=$?
fi

##  All done.
##  The exit status is 1 if the rotation or the resume of the server failed.
if [ "${result}" -ne 0 ] || [ "${RESUMESTATUS}" -ne 0 ]; then
    exit 1
fi
exit 0
