From 390be334cf783278943cf249179f39d2e77e8b00 Mon Sep 17 00:00:00 2001
From: go-while <go-while@users.noreply.github.com>
Date: Fri, 6 Nov 2026 14:08:07 +0000
Subject: [PATCH 6/7] tests/lib: Stop innconf tests after a configuration read
 failure

A bad generated sample configuration, such as one configured with an
empty hostname, makes innconf_read fail. Bail out with that cause rather
than passing NULL configurations to innconf_compare and crashing.

This only changes failure reporting in the test. The CI VM still needs
a nonempty hostname to produce a valid sample configuration.

Co-Authored-By: GPT-6.1 Sol <noreply@openai.com>
---
 tests/lib/innconf-t.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/tests/lib/innconf-t.c b/tests/lib/innconf-t.c
index 297372d88..8219ba31c 100644
--- a/tests/lib/innconf-t.c
+++ b/tests/lib/innconf-t.c
@@ -43,12 +43,16 @@ main(void)
 
     if (system(cat) != 0)
         die("Unable to create stripped configuration file");
-    ok(1, innconf_read("config/tmp2"));
+    if (!innconf_read("config/tmp2"))
+        bail("cannot read generated config/tmp2");
+    ok(1, true);
     standard = innconf;
     innconf = NULL;
     if (system(grep) != 0)
         die("Unable to create stripped configuration file");
-    ok(2, innconf_read("config/tmp"));
+    if (!innconf_read("config/tmp"))
+        bail("cannot read generated config/tmp");
+    ok(2, true);
     unlink("config/tmp");
     unlink("config/tmp2");
     ok(3, innconf_compare(standard, innconf));
-- 
