From b4459f4a896aa966cd726435bab187167976d3b1 Mon Sep 17 00:00:00 2001
From: go-while <go-while@users.noreply.github.com>
Date: Fri, 6 Nov 2026 14:05:39 +0000
Subject: [PATCH 4/7] tests/authprogs: Fall back to bcrypt when DES is
 unavailable

OpenBSD crypt only supports bcrypt, so all successful authentications
using the DES-only password fixture fail.  Add an equivalent bcrypt
fixture and use it when crypt(3) cannot make DES hashes.  The probe
calls crypt(3) through Perl rather than through ckpasswd, so that a
ckpasswd bug cannot select the other fixture; without Perl, DES is
assumed as before.

Keep DES for older crypt implementations without bcrypt.  The same seven
authentication and rejection assertions run with either fixture; none
are skipped.  No production authentication behavior changes.

Co-Authored-By: GPT-6.1 Sol <noreply@openai.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 MANIFEST                     |  1 +
 tests/authprogs/ckpasswd.t   | 27 ++++++++++++++++++++-------
 tests/data/etc/passwd-bcrypt | 10 ++++++++++
 3 files changed, 31 insertions(+), 7 deletions(-)
 create mode 100644 tests/data/etc/passwd-bcrypt

diff --git a/MANIFEST b/MANIFEST
index 491795f54..523a2c174 100644
--- a/MANIFEST
+++ b/MANIFEST
@@ -947,6 +947,7 @@ tests/data/etc/inn-bfx.conf           Basic inn.conf for testing buffindexed
 tests/data/etc/inn-tdx.conf           Basic inn.conf for testing tradindexed
 tests/data/etc/inn.conf               Basic inn.conf file for testing
 tests/data/etc/passwd                 Password data for ckpasswd tests
+tests/data/etc/passwd-bcrypt          Bcrypt password data for ckpasswd tests
 tests/data/etc/storage.conf           Storage configuration for testing
 tests/data/overview                   Test overview data (Directory)
 tests/data/overview/1-4               Overview info for test articles 1-4
diff --git a/tests/authprogs/ckpasswd.t b/tests/authprogs/ckpasswd.t
index d8c82ca5d..d0cd01548 100755
--- a/tests/authprogs/ckpasswd.t
+++ b/tests/authprogs/ckpasswd.t
@@ -64,19 +64,32 @@ for dir in ../data data tests/data; do
 done
 ckpasswd=../../authprogs/ckpasswd
 
+# Some crypt implementations, notably OpenBSD's, no longer support DES.
+# Keep the old fixture for systems without bcrypt, but use the bcrypt
+# equivalent when crypt(3) cannot make DES hashes.  The probe calls crypt(3)
+# through Perl rather than through ckpasswd, so that a ckpasswd bug cannot
+# select the other fixture.  Without Perl, DES is assumed, as before.  All
+# tests still run.
+passwd=etc/passwd
+des_probe='my $h = crypt("foopass", "ab");
+exit(defined($h) && length($h) == 13 ? 0 : 1);'
+if command -v perl >/dev/null 2>&1 && ! perl -e "$des_probe" 2>/dev/null; then
+    passwd=etc/passwd-bcrypt
+fi
+
 # Print the test count.
 echo 7
 
 # First, run the tests that we expect to succeed.
-runsuccess "foo" "foopass" "-f etc/passwd" "User:foo"
-runsuccess "bar" "barpass" "-f etc/passwd" "User:bar"
-runsuccess "baz" "" "-f etc/passwd" "User:baz"
-runpipe "foo" "foopass" "-f etc/passwd" "User:foo"
+runsuccess "foo" "foopass" "-f $passwd" "User:foo"
+runsuccess "bar" "barpass" "-f $passwd" "User:bar"
+runsuccess "baz" "" "-f $passwd" "User:baz"
+runpipe "foo" "foopass" "-f $passwd" "User:foo"
 
 # Now, run the tests that we expect to fail.
-runfailure "foo" "barpass" "-f etc/passwd" \
+runfailure "foo" "barpass" "-f $passwd" \
     "ckpasswd: invalid password for user foo"
-runfailure "who" "foopass" "-f etc/passwd" \
+runfailure "who" "foopass" "-f $passwd" \
     "ckpasswd: user who unknown"
-runfailure "" "foopass" "-f etc/passwd" \
+runfailure "" "foopass" "-f $passwd" \
     "ckpasswd: null username"
diff --git a/tests/data/etc/passwd-bcrypt b/tests/data/etc/passwd-bcrypt
new file mode 100644
index 000000000..a4c4cca84
--- /dev/null
+++ b/tests/data/etc/passwd-bcrypt
@@ -0,0 +1,10 @@
+# The same accounts and passwords as passwd, using bcrypt rather than DES.
+foo:$2a$04$abcdefghijklmnopqrstuu8gLpt12CFBki7Qi5dgE/7vmyxBgzO3u:5:5:Foo Bar:/home/foo:/bin/sh
+
+# This is another comment.
+
+This is just some random text that someone put in this file for no good
+reason.
+
+bar:$2a$04$abcdefghijklmnopqrstuuH0H.2uetuU6mVKFJF9n4Y6nwxQ2uKQ.
+baz:$2a$04$abcdefghijklmnopqrstuubyCG3zY1GIXMyxfivm.ClDiInHzxjiq::::::::::::::::::::::
