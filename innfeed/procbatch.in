#! /usr/bin/perl
# fixscript will replace this line with code to load INN::Config

# Author:       James Brister <brister@vix.com> -- berkeley-unix --
# Start Date:   Thu May 16 10:32:02 1996 +0200
#
# Description: Take a file of the form generated by innd in the outgoing
#              directory ("Wnm*") and separate it into tape files for innfeed.
#
# Thanks to Clayton O'Neill <coneill@premier.net> for serious speed
# improvements.
#
# Various bug fixes, code and documentation improvements since then
# in 1997-1999, 2004, 2007, 2009, 2011, 2021-2024.

#
#        Hmm, perhaps we should try to read "backlog-directory"
#        from innfeed.conf.  Oh well.
#
use strict;
use warnings;

my $tapeDir = $INN::Config::pathspool . "/innfeed";
my $destDir = $INN::Config::pathtmp;
my $spoolArts = $INN::Config::patharticles;
my $outGoing = $INN::Config::pathoutgoing;

##
## Everything below here should probably be left alone.
##

$0 =~ s!.*/!!;

use Getopt::Std;

# Define variables Getopt::Std uses for --help and --version.
$Getopt::Std::STANDARD_HELP_VERSION = 1;
our $VERSION = $INN::Config::version;
$VERSION =~ s/INN //;

my $usage = "Usage:
  $0 [-hquv] [-c [-s dir]] [-d dir] [-e host] [-m [-t dir]] inn-batchfile

Options:
  -c         to check that the articles still exist before storing them
  -d dir     to put the output file(s) in that directory ($destDir)
  -e host    to process on entries for only that host
  -h         display a short help screen
  -m         to have $0 move the new files to the backlog directory
  -q         quiet mode: only display error messages; good for cron jobs
  -s dir     to specify where the news articles are
             ($spoolArts)
  -t dir     to specify the backlog directory ($tapeDir)
  -u         to unlink the input files when finished
  -v         for verbosity

  $0 will take an INN funnel file (normally a file in
  $outGoing), or an innfeed \"dropped\" file,
  which is presumed to be of the format:

      pathname message-id peer1 peer2 peer3 ...

  and will break it up into files peer1.tmp, peer2.tmp, peer3.tmp...
  Each of these files will be of the format:

      pathname message-id

  that is the same as innfeed's backlog file format.  Simply rename these
  files to peer1, peer2, peer3... in a running innfeed's backlog directory
  and they will be picked up automatically and processed by innfeed.
  Use the '-m' flag and they'll be moved automatically.
";

sub HELP_MESSAGE {
    print $usage;
    exit(0);
}

# Ask the storage manager about the given storage tokens.  Return references
# to two hashes keyed by token: the articles that do not exist, and the
# articles whose existence could not be determined because of an error of the
# storage system (the value is sm's explanation).  A single sm process checks
# all the tokens, and its standard error is the only output read here.  Die
# when the check is not complete or sm reports anything unexpected, so that
# no entry is dropped on an uncertain answer.
sub check_articles {
    my @tokens = @_;
    my (%wanted, %missing, %unknown, @errors);
    $wanted{$_} = 1 foreach @tokens;

    my $pid = open(my $SM, '-|');
    die "$0: cannot fork: $!\n" unless defined $pid;
    if ($pid == 0) {
        # Send the messages of sm to the parent and discard the headers of
        # the articles it retrieves.
        open(STDERR, '>&STDOUT') or die "$0: cannot dup stdout: $!\n";
        open(STDOUT, '>', '/dev/null')
          or die "$0: cannot open /dev/null: $!\n";
        # -e makes sm tell a missing article from a retrieval error.
        open(my $TOKENS, '|-', "$INN::Config::newsbin/sm", '-e', '-H')
          or die "$0: cannot exec sm: $!\n";
        $SIG{PIPE} = 'IGNORE';
        my $sent = 1;
        foreach my $token (@tokens) {
            print {$TOKENS} "$token\n" or $sent = 0;
        }
        close $TOKENS;
        # Exit with 0 if all the articles exist, 1 if sm exited with the
        # status it uses when it could not retrieve some of them, and 2 on
        # anything else: sm failed or did not get all the tokens.
        exit($sent && $? == 0 ? 0 : $sent && $? == 256 ? 1 : 2);
    }
    while (my $line = <$SM>) {
        chomp $line;
        my ($kind, $token, $reason) = ('');
        if ($line =~ /^sm: article (\S+) does not exist$/) {
            ($kind, $token) = ('missing', $1);
        } elsif ($line =~ /^sm: (\S+) is not a storage token$/) {
            ($kind, $token) = ('missing', $1);
        } elsif ($line =~ /^sm: could not retrieve (\S+): (.+)$/) {
            ($kind, $token, $reason) = ('unknown', $1, $2);
        }
        if ($kind eq 'missing' && $wanted{$token}) {
            $missing{$token} = 1;
        } elsif ($kind eq 'unknown' && $wanted{$token}) {
            $unknown{$token} = $reason;
        } else {
            push @errors, $line;
        }
    }
    close $SM;
    # The child exits with 0, 1 or 2; if it was killed by a signal, the low
    # bits of $? are set and its exit code says nothing.
    my $status = ($? & 127) ? 2 : $? >> 8;

    # sm exits with status 1 when it could not retrieve some articles, which
    # is expected only if it reported one; any other status is a failure, and
    # so are messages that do not concern a particular token.
    my $explained = %missing || %unknown;
    if (@errors || $status > 1 || ($status == 1 && !$explained)) {
        die "$0: cannot check the articles with sm:\n"
          . join("\n", @errors) . "\n"
          if @errors;
        die "$0: cannot check the articles with sm: exit status $status\n";
    }
    return (\%missing, \%unknown);
}

my (%opt, %hosts);
my ($missing, $unchecked) = (0, 0);
getopts("cd:e:hmqs:t:uv", \%opt) || die $usage;

HELP_MESSAGE() if $opt{'h'};
die "Cannot specify both -q and -v\n\n" . $usage if ($opt{'q'} && $opt{'v'});

$spoolArts = $opt{'s'} if $opt{'s'};
$destDir = $opt{'d'} if $opt{'d'};
$tapeDir = $opt{'t'} if $opt{'t'};
my $inputFile = shift;

die $usage if !$inputFile;
unless (-f $inputFile) {
    exit if $opt{'q'};
    die "No such file: $inputFile\n\n" . $usage;
}
die "No such directory: $spoolArts\n\n" . $usage
  if (!-d $spoolArts && $opt{'c'});
die "No such directory: $destDir\n\n" . $usage if (!-d $destDir);
die "No such directory: $tapeDir\n\n" . $usage if (!-d $tapeDir && $opt{'m'});
warn "Specifying -s without -c has no effect!" if $opt{'s'} and not $opt{'c'};
warn "Specifying -t without -m has no effect!" if $opt{'t'} and not $opt{'m'};

print "Using $inputFile\n" if $opt{'v'};

# With -c, first collect the storage tokens of the batchfile and ask the
# storage manager about all of them at once.
my ($missingArticles, $unknownArticles) = ({}, {});
if ($opt{'c'}) {
    my %tokens;
    open(my $TOKENS, '<', $inputFile) || die "$0: open ($inputFile): $!\n";
    while (<$TOKENS>) {
        $tokens{$1} = 1 if m!^(\@[0-9A-F]+\@) <.+@.+> \S+!;
    }
    close $TOKENS;
    ($missingArticles, $unknownArticles) = check_articles(keys %tokens)
      if %tokens;
    foreach my $token (sort keys %{$unknownArticles}) {
        warn "$0: cannot tell whether $token exists, keeping its entries: "
          . "$unknownArticles->{$token}\n";
        $unchecked++;
    }
}

open(my $INPUT, '<', $inputFile) || die "$0: open ($inputFile): $!\n";

while (<$INPUT>) {
    chop;
    my @F = split;

    # Check the format of the line vigorously
    next unless (m!^\S+/\d+ <.+@.+> \S+! || m!^@[0-9A-F]+@ <.+@.+> \S+!);

    if ($opt{'c'}) {
        if ($F[0] =~ /^\@/) {
            if ($missingArticles->{ $F[0] }) {
                $missing++;
                print "Dropping article: $F[0]\n" if $opt{'v'};
                next;
            }
        } elsif (!-f "$spoolArts/$F[0]") {
            $missing++;
            print "Dropping file: $spoolArts/$F[0]\n" if $opt{'v'};
            next;
        }
    }

    for (my $i = 2; $i <= $#F; $i++) {
        my $host = $F[$i];
        next if ($opt{'e'} && $opt{'e'} ne $host);

        # Keep out host names with any funny characters (from
        # corrupted files)
        if ($host !~ /^[-\._0-9A-Za-z]+$/) {
            warn "$0: bad site name ignored: \"$host\"\n";
            next;
        }

        if ($hosts{$host}) {
            print { $hosts{$host} } "$F[0] $F[1]\n";
        } else {
            my $outputFile = "$destDir/$host.tmp";
            print "Starting $host\n" if ($opt{'v'});
            open $hosts{$host}, '>>', $outputFile
              or die "open >>$outputFile: $!\n";
            print { $hosts{$host} } "$F[0] $F[1]\n";
        }
    }
}
close $INPUT;

foreach my $host (keys %hosts) {
    close $hosts{$host};
    my $outputFile = "$destDir/$host.tmp";
    my $tmpTape = "$tapeDir/$host.tmp";
    my $tapeFile = "$tapeDir/$host";
    if ($opt{'m'}) {
        if ($outputFile ne $tmpTape) {
            my $cmd = "mv $outputFile $tmpTape";
            system $cmd;
            die "$0: $cmd: failed\n" unless ($? == 0);
        }

        my $cmd
          = "cat $tmpTape | $INN::Config::sort -u"
          . " >> $tapeFile && rm -f $tmpTape";
        system $cmd;
        die "$0: $cmd: failed\n" unless ($? == 0);
    }
}

unlink $inputFile if $opt{'u'};

print "$missing articles dropped\n" if ($opt{'v'} && $missing > 0);

# The entries of the articles that could not be checked have been kept, but
# the check was not complete.
if ($unchecked > 0) {
    warn "$0: $unchecked storage tokens could not be checked\n";
    exit 1;
}
